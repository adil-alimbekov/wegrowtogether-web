{
  "name": "wegrowtogether-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:api": "tsx --env-file-if-exists=.env.local server/dev.ts",
