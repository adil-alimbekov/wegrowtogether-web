# Браузер (публичные значения из Supabase → Project Settings → API)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# 1 — включить вход по SMS (нужен SMS-провайдер в Supabase → Auth → Phone)
VITE_PHONE_AUTH=0

# Сервер (Vercel → Settings → Environment Variables)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=
# необязательно, по умолчанию claude-opus-5-5
ANTHROPIC_MODEL=
